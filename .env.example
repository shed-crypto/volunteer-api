# ─── Сервер ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# CORS: дозволені origins для мобільного клієнта та браузера.
# Для dev можна залишити *, для production — конкретні домени.
CORS_ORIGIN=*

# ─── База даних ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=volunteer
DB_PASSWORD=volunteer_pass
DB_NAME=volunteer_help
# УВАГА: true ЛИШЕ для розробки. На production завжди false (використовуй міграції).
DB_SYNCHRONIZE=true
DB_LOGGING=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
# ВАЖЛИВО: Замінити на справжні секрети перед деплоєм!
# Мінімум 32 символи. Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ЗАМІНИТИ_НА_ВИПАДКОВИЙ_РЯДОК_МІН_32_СИМВОЛИ
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ЗАМІНИТИ_НА_ІНШИЙ_ВИПАДКОВИЙ_РЯДОК_МІН_32_СИМВОЛИ
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Rate Limiting (необов'язково, є дефолти) ─────────────────────────────────
# THROTTLE_TTL=60000    # вікно в мілісекундах (60 секунд)
# THROTTLE_LIMIT=60     # максимум запитів у вікні

# ─── Email (підтвердження пошти та скидання пароля) ───────────────────────────
# Якщо не налаштовано — система працює, але листи тільки логуються в консоль.
# Gmail: включіть "App Passwords" у налаштуваннях Google Account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
# Ім'я та адреса відправника
SMTP_FROM="Волонтерська допомога" <your_email@gmail.com>

# Публічна URL вашого сервера (для посилань у листах)
APP_URL=http://localhost:3000

# ─── Telegram Bot (необов'язково) ─────────────────────────────────────────────
# Отримати токен у @BotFather → /newbot
# УВАГА: ніколи не комітьте реальний токен у git!
TELEGRAM_BOT_TOKEN=

# ─── Обфускування координат ───────────────────────────────────────────────────
# Радіус (в метрах) для приховування точних координат чутливих заявок
LOCATION_OBFUSCATION_RADIUS_M=3000
# Кількість поручителів для доступу до завдань "Червона зона"
FRONTLINE_VOUCHES_REQUIRED=3
